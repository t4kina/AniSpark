<?xml version="1.0" encoding="utf-8"?>
<!-- How the "Up next" widget looks in the widget picker: its shape, without
     data (widget_up_next.xml is the real one). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_preview_dot" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_up_next"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_brand"
            android:textColor="#80FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="27dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_cover_placeholder" />

            <ImageView
                android:layout_width="96dp"
                android:layout_height="8dp"
                android:layout_marginTop="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_preview_accent_bar" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="27dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_cover_placeholder" />

            <ImageView
                android:layout_width="96dp"
                android:layout_height="8dp"
                android:layout_marginTop="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_preview_accent_bar" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="27dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_cover_placeholder" />

            <ImageView
                android:layout_width="96dp"
                android:layout_height="8dp"
                android:layout_marginTop="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_preview_accent_bar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
